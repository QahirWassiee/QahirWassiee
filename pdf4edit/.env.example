# Copy to .env (or set in your host's dashboard).
PORT=3000
NODE_ENV=production
# Public URL of the site, used for Stripe redirects.
BASE_URL=https://pdf4edit.com
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Optional: a $4.99/month recurring Price you created in Stripe. If unset,
# checkout creates the $4.99/month price inline.
STRIPE_PRICE_ID=price_...
# From the webhook endpoint you add for https://YOUR-SITE/api/stripe/webhook
# (events: checkout.session.completed, customer.subscription.*)
STRIPE_WEBHOOK_SECRET=whsec_...
# Where the SQLite database lives (use a persistent disk in production).
DATABASE_FILE=./data/pdf4edit.db
